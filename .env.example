NODE_ENV=development
PORT=3002

# --- Base de datos (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=org_user
DB_PASSWORD=secret
DB_NAME=organization_db

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Aprovisionamiento de terminales POS (emparejamiento) ---
AUTH_SERVICE_URL=http://localhost:3001
# Debe coincidir con INTERNAL_SERVICE_SECRET en auth-service (.env)
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me
